      "tipover",
      "hull_contact",
      "obstacle_contact",
      "no_pad_support"
    ],
    "note": "success_like means conditional support under these S/E settings only"
  ,
    "class_definitions": {
      "floor_contact": "any aircraft geom touched the floor at any time (failure; never success)",
      "tipover": "max tilt above tilt_tipover_deg",
      "hull_contact": "a non-foot aircraft geom (PCB, battery, motor column, arm) touched pad/column/board without exceeding the tipover tilt",
      "obstacle_contact": "a foot touched the marker board or cart column",
      "no_pad_support": "no foot in pad contact over the end window",
      "partial_support": "1-2 feet in contact, final tilt above tilt_hold_max_deg, CoM outside pad, a foot centre beyond the pad edge, or tilt creep above tilt_creep_max_deg_s at end",
      "slip": "supported but post-settle slip or final relative speed above thresholds",
      "hold_after_slip": "supported and stationary relative to pad after a touchdown slip above touchdown_slip_hold_max_m",
      "hold": "supported by >=3 feet, stationary relative to pad, touchdown slip within threshold"
    }
  },
